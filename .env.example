# Copy this to your Cloudflare Pages project's environment variables (Settings
# > Environment variables) — never commit a real .env file with actual secrets.

# Required
GEMINI_API_KEY=

# Optional — override the default Gemini model (see functions/_lib/gemini.js)
# GEMINI_MODEL=gemini-3.6-flash

# Optional / future — only needed if Maven applies for and receives approved
# Reddit API access under Reddit's Responsible Builder Policy. Leave unset and
# the app will correctly report Reddit profile/thread access as unavailable
# and use the paste-based fallback instead.
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=shill-ulate-internal-tool/1.0 (by /u/your-reddit-username)
